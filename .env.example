# Example .env for Runekeeper
# Copy this to .env and fill in the values.

# Required
discord_token=YOUR_DISCORD_TOKEN_HERE

# Optional - persistence
# Defaults to sqlite in the repo root if unset
DATABASE_URL=sqlite:///runekeeper.db

# Optional - Brawlhalla polling (must include {handle} placeholder)
BRAWLHALLA_API_ENDPOINT=
BRAWLHALLA_API_KEY=
BRAWLHALLA_POLL_INTERVAL=60

# Optional - Spotify (not required for YouTube playback)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
