# Example environment variables

# Discord bot token
DISCORD_TOKEN=

# Optional: Brawlhalla API key to enable profile/match lookups
BRAWLHALLA_API_KEY=

# Optional: Brawlhalla API endpoint template. Must include {handle}.
BRAWLHALLA_API_ENDPOINT=https://api.example.com/brawlhalla/{handle}

# Optional: Poll interval in seconds for Brawlhalla API updates
BRAWLHALLA_POLL_INTERVAL=60

# SQLAlchemy database URL. Defaults to sqlite:///runekeeper.db
DATABASE_URL=sqlite:///runekeeper.db

# Ensure ffmpeg is installed and available on PATH for music playback support.
